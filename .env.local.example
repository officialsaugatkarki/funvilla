# Khukuri Hospitality Management Platform — Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE
# =============================================================================
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️  NEVER expose this on the client. Server-only (admin operations).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# APP
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin

# Production (subdomain routing via middleware)
# NEXT_PUBLIC_APP_URL=https://restaurant.com
# NEXT_PUBLIC_ADMIN_URL=https://app.restaurant.com

# =============================================================================
# RESTAURANT
# Used to identify which restaurant record to load if multi-tenant in future
# =============================================================================
NEXT_PUBLIC_RESTAURANT_SLUG=khukuri

# =============================================================================
# WHATSAPP
# =============================================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=+9779855073719

# =============================================================================
# EMAIL (Optional — for transactional emails beyond Supabase Auth)
# Supabase built-in handles: magic links, password reset
# Add Resend for: booking confirmations, order receipts
# =============================================================================
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=noreply@restaurant.com
